{
  "family": "sandbox-manager",
  "taskRoleArn": "arn:aws:iam::654654524154:role/sandbox-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::654654524154:role/sandbox-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "manager",
      "image": "654654524154.dkr.ecr.us-west-1.amazonaws.com/shortbox/manager:latest",
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        { "containerPort": 8000, "hostPort": 8000, "protocol": "tcp" }
      ],
      "essential": true,
      "environment": [
        { "name": "CLUSTER_NAME", "value": "sandbox-cluster" },
        {
          "name": "SUBNET_IDS",
          "value": "subnet-0c7e7c6f1d4f9c8b7,subnet-0a1b2c3d4e5f6g7h8"
        },
        { "name": "SECURITY_GROUP_ID", "value": "sg-0123456789abcdef0" },
        { "name": "AWS_DEFAULT_REGION", "value": "us-west-1" },
        { "name": "IS_LOCAL", "value": "false" },
        {
          "name": "ALB_DNS",
          "value": "sandbox-alb-103265220.us-west-1.elb.amazonaws.com"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sandbox",
          "awslogs-region": "us-west-1",
          "awslogs-stream-prefix": "manager"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "8192"
}
