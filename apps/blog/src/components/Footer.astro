---
import { Icon } from "astro-icon/components";

const today = new Date();
---

<footer
  class="bg-black bg-opacity-50 backdrop-filter backdrop-blur-md shadow-md px-4 sm:px-6 md:px-10 lg:px-12 py-4 border-t border-white/10"
>
  <div class="max-w-6xl mx-auto flex justify-between items-center py-8">
    <a href="https://speck.sh" class="flex items-center space-x-2">
      <div class="text-white text-sm">
        &copy; {today.getFullYear()} Speck
      </div>
      <img src="/speck-icon.png" alt="Speck" class="w-4 h-4" />
    </a>
    <div class="flex space-x-4">
      <a
        href="https://x.com/speck_ai"
        target="_blank"
        class="text-white hover:text-gray-300 transition-colors"
      >
        <span class="sr-only">Twitter</span>
        <Icon name="ri:twitter-x-line" class="w-6 h-6" />
      </a>
      <a
        href="https://www.linkedin.com/company/speck"
        target="_blank"
        class="text-white hover:text-gray-300 transition-colors"
      >
        <span class="sr-only">LinkedIn</span>
        <Icon name="mdi:linkedin" class="w-6 h-6" />
      </a>
    </div>
  </div>
</footer>
