---
import Author from "./Author.astro";
import FormattedDate from "./FormattedDate.astro";

const { slug, data } = Astro.props;
const { title, heroImage, pubDate, author } = data;
---

<div
  class="mb-8 bg-black bg-opacity-50 border border-white/20 rounded-2xl p-4 shadow-lg"
>
  <a
    href={`/page/${slug}/`}
    class="block hover:opacity-80 transition-opacity group"
  >
    <div class="flex items-center">
      <div
        class="w-3/5 sm:w-1/2 md:w-3/5 lg:w-2/3 overflow-hidden rounded-lg shadow-md mr-4"
      >
        <img
          width={720}
          height={360}
          src={heroImage}
          alt=""
          class="w-full h-72 object-cover object-center transition-transform duration-300 ease-in-out group-hover:scale-110"
        />
      </div>
      <div>
        <h4 class="text-xl font-semibold text-white">{title}</h4>

        <p class="text-gray-400 mt-2">
          <FormattedDate date={pubDate} />
          <Author author={author} />
        </p>
      </div>
    </div>
  </a>
</div>
