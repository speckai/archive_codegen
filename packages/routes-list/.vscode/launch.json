  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug findImports",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/findImports.ts",
      "args": [
        "./test/interface-to-prompt/apps/web/tsconfig.json",
        "./test/interface-to-prompt/apps/web/app/stores/cards-store.ts"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "tsc: build - tsconfig.json",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug findImports Speck",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/findImports.ts",
      "args": [
        "./test/speck-template/tsconfig.json",
        "./test/speck-template/app/page.tsx"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "tsc: build - tsconfig.json",
      "sourceMaps": true
    }
  ]
}
