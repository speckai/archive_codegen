{
  "compilerOptions": {
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "target": "ES2019",
    "lib": ["ES2019"],
    "strict": true,
    "declaration": true,
    "moduleResolution": "node"
  },
  "include": ["src"],
  "exclude": ["test", "node_modules"]
}
